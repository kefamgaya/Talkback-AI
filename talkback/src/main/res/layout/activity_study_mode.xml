<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/soma_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soma_study_background"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/soma_top_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/soma_study_background"
      android:gravity="center_vertical"
      android:minHeight="72dp"
      android:orientation="horizontal"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/soma_logo_background"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/soma_ai_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/soma_page_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:accessibilityHeading="true"
          android:text="@string/nav_study"
          android:textColor="@color/soma_study_text_primary"
          android:textSize="21sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/soma_page_subtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="@string/study_page_subtitle"
          android:textColor="@color/soma_study_text_secondary"
          android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <include android:id="@+id/study_page" layout="@layout/view_study_page" />
    <include android:id="@+id/models_page" layout="@layout/view_models_page" android:visibility="gone" />
    <include android:id="@+id/settings_page" layout="@layout/view_settings_page" android:visibility="gone" />
  </FrameLayout>

  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/soma_bottom_navigation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/soma_study_surface"
      android:minHeight="72dp"
      android:paddingTop="4dp"
      app:itemActiveIndicatorColor="@color/soma_study_surface_tint"
      app:itemIconTint="@color/soma_bottom_navigation_color"
      app:itemTextColor="@color/soma_bottom_navigation_color"
      app:labelVisibilityMode="labeled"
      app:menu="@menu/soma_bottom_navigation" />
</LinearLayout>
