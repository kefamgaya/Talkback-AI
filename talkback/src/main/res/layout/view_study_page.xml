<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingTop="16dp"
      android:paddingEnd="20dp"
      android:paddingBottom="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.08"
        android:text="@string/study_hero_title"
        android:textColor="@color/soma_study_text_primary"
        android:textSize="30sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/study_mode_description"
        android:textColor="@color/soma_study_text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/soma_privacy_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">
      <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:importantForAccessibility="no"
          android:src="@drawable/soma_lock"
          app:tint="@color/soma_study_success" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="@string/study_privacy_badge"
          android:textColor="@color/soma_study_success"
          android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/study_open_note_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="@string/study_open_note"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="18dp"
        app:icon="@drawable/soma_document"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />
    <TextView
        android:id="@+id/study_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/study_no_note_open"
        android:textColor="@color/soma_study_text_secondary"
        android:textSize="13sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/soma_study_border" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.08"
        android:text="@string/study_workspace_label"
        android:textAllCaps="true"
        android:textColor="@color/soma_study_primary"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/study_document_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityHeading="true"
        android:text="@string/study_empty_note_title"
        android:textColor="@color/soma_study_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/study_document_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/soma_study_text_primary"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/study_read_note_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="@string/study_read_note_aloud"
        android:textAllCaps="false"
        android:visibility="gone"
        app:icon="@drawable/soma_volume"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:accessibilityHeading="true"
        android:text="@string/study_question_section_title"
        android:textColor="@color/soma_study_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/study_question_section_description"
        android:textColor="@color/soma_study_text_secondary"
        android:textSize="14sp" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/study_question_hint"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxStrokeColor="@color/soma_study_primary"
        app:counterEnabled="true"
        app:counterMaxLength="500">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/study_question"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:enabled="false"
          android:imeOptions="actionSend"
          android:inputType="textCapSentences|textMultiLine"
          android:maxLength="500"
          android:maxLines="4"
          android:minHeight="104dp"
          android:paddingTop="18dp"
          android:paddingBottom="18dp"
          android:textColor="@color/soma_study_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/study_voice_question_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:enabled="false"
        android:text="@string/study_ask_by_voice"
        android:textAllCaps="false"
        app:icon="@drawable/soma_microphone"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/study_ask_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="@string/study_find_passage"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/soma_search"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />
    <TextView
        android:id="@+id/study_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/soma_answer_background"
        android:lineSpacingExtra="4dp"
        android:padding="18dp"
        android:textColor="@color/soma_study_text_primary"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:visibility="gone" />
  </LinearLayout>
</ScrollView>
